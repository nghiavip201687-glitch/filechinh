-- LOAD SCRIPT
local function LoadScript(scriptData)

    if not scriptData.URL or scriptData.URL == "" then

        Status.Text = "● Script URL is empty"

        Status.TextColor3 = Color3.fromRGB(255, 100, 100)

        return

    end



    if type(loadstring) ~= "function" then

        Status.Text = "● loadstring is not supported"

        Status.TextColor3 = Color3.fromRGB(255, 100, 100)

        return

    end



    Status.Text = "● Loading " .. scriptData.Name .. "..."

    Status.TextColor3 = Color3.fromRGB(255, 200, 80)



    task.spawn(function()

        local ok, err = pcall(function()

            local source = game:HttpGet(scriptData.URL)



            if type(source) ~= "string" or source == "" then

                error("Could not download script")

            end



            local func, compileError = loadstring(source)



            if not func then

                error(compileError or "Compile failed")

            end



            func()

        end)



        if ok then

            Status.Text = "● Loaded: " .. scriptData.Name

            Status.TextColor3 = Color3.fromRGB(100, 220, 150)

        else

            Status.Text = "● Error: " .. tostring(err)

            Status.TextColor3 = Color3.fromRGB(255, 100, 100)

            warn("[MEMAYBEO HUB] " .. tostring(err))

        end

    end)

end
