        local categoryMatch =
                (currentCategory == "BLOX FRUIT" and data.Category == "BLOX FRUIT")
                or (currentCategory == "KHÁC" and data.Category ~= "BLOX FRUIT")

        local searchMatch =

            searchText == ""

            or string.find(string.lower(data.Name), searchText, 1, true)

            or string.find(string.lower(data.Description), searchText, 1, true)



        if categoryMatch and searchMatch then

            CreateCard(data)

        end

    end



    task.wait()

    List.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 10)

