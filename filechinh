-- DRAGGABLE FLOATING IMAGE (mouse + touch)
local imageDragging = false
local imageMoved = false
local dragInput = nil
local dragStartPos = nil
local imageStartPos = nil
local DRAG_THRESHOLD = 6

ToggleImage.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        imageDragging = true
        imageMoved = false
        dragInput = input
        dragStartPos = input.Position
        imageStartPos = ToggleImage.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if not imageDragging then return end

    local isMouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
    local isTouchMove = dragInput and dragInput.UserInputType == Enum.UserInputType.Touch
        and input == dragInput

    if isMouseMove or isTouchMove then
        local delta = input.Position - dragStartPos
        if math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD then
            imageMoved = true
        end

        if imageMoved then
            ToggleImage.Position = UDim2.new(
                imageStartPos.X.Scale,
                imageStartPos.X.Offset + delta.X,
                imageStartPos.Y.Scale,
                imageStartPos.Y.Offset + delta.Y
            )
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    local matchingRelease = input.UserInputType == Enum.UserInputType.MouseButton1
        or (dragInput and dragInput.UserInputType == Enum.UserInputType.Touch
            and input == dragInput)

    if imageDragging and matchingRelease then
        imageDragging = false
        dragInput = nil

        -- Only toggle the hub when the image was tapped, not dragged.
        if not imageMoved then
            Main.Visible = not Main.Visible
        end
    end
end)

