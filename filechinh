-- MINIMIZE / MAXIMIZE
local minimized = false
local maximized = false
local normalSize = UDim2.new(0, 650, 0, 410)
local maximizedSize = UDim2.new(0, 850, 0, 540)

local function ResizeHub(targetSize)
    Main:TweenSize(targetSize, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
    Main.Position = UDim2.new(0.5, -targetSize.X.Offset / 2, 0.5, -targetSize.Y.Offset / 2)
end

Minimize.MouseButton1Click:Connect(function()
    minimized = not minimized
    Sidebar.Visible = not minimized
    Content.Visible = not minimized

    local targetSize = minimized and UDim2.new(0, maximized and 850 or 650, 0, 48)
        or (maximized and maximizedSize or normalSize)
    ResizeHub(targetSize)
    Minimize.Text = minimized and "+" or "—"
end)

Maximize.MouseButton1Click:Connect(function()
    maximized = not maximized
    minimized = false
    Sidebar.Visible = true
    Content.Visible = true
    Minimize.Text = "—"
    Maximize.Text = maximized and "❐" or "□"
    ResizeHub(maximized and maximizedSize or normalSize)
end)

-- DRAG
local dragging = false

local dragStart

local startPos



Top.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = true

        dragStart = input.Position

        startPos = Main.Position

    end

end)



UIS.InputChanged:Connect(function(input)

    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then

        local delta = input.Position - dragStart

        Main.Position = UDim2.new(

            startPos.X.Scale,

            startPos.X.Offset + delta.X,

            startPos.Y.Scale,

            startPos.Y.Offset + delta.Y

        )

    end

end)



UIS.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = false

    end

end)
